{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uiviu",
  // The only Worker code is the canonical-host redirect; everything else is
  // pre-rendered. Keep this at or before the installed workerd date.
  "compatibility_date": "2026-10-28",
  // Runs for every request (see `assets.run_worker_first` below) to send
  // `www.uiviu.me` to the apex, then hands the request to the asset binding.
  "main": "worker/index.ts",
  // Custom domains are declarative: a deploy attaches exactly these. Keep the
  // apex listed, otherwise deploying only `www` detaches the apex.
  "routes": [
    { "pattern": "uiviu.me", "custom_domain": true },
    { "pattern": "www.uiviu.me", "custom_domain": true },
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // Asset-first routing would answer `www` from the built files before the
    // script could redirect, so the script has to run first.
    "run_worker_first": true,
    "binding": "ASSETS",
    // Serve dist/404.html with a 404 status for unmatched routes.
    "not_found_handling": "404-page",
  },
}
