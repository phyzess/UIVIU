{
  "name": "uiviu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm fonts:ensure && astro dev",
    "build:astro": "astro build",
    "search:index": "pagefind --site dist",
    "build": "pnpm fonts:ensure && pnpm build:astro && pnpm search:index",
    "build:prod": "pnpm content:sync:remote && pnpm build",
    "preview": "astro preview",
    "preview:worker": "wrangler dev",
    "astro": "astro",
    "content:sync": "node scripts/content.mjs sync",
    "content:sync:fixtures": "node scripts/content.mjs sync --fixtures",
    "content:sync:remote": "node scripts/content.mjs sync --remote",
    "content:status": "node scripts/content.mjs status",
    "content:check": "node scripts/content.mjs check",
    "check": "astro check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fonts:build": "node scripts/fonts.mjs build",
    "fonts:check": "node scripts/fonts.mjs check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm fonts:ensure && pnpm check && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "deploy": "pnpm build:prod && wrangler deploy",
    "postinstall": "simple-git-hooks",
    "fonts:ensure": "node scripts/fonts.mjs ensure"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "fontverter": "^2.0.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "pagefind": "^1.5.2",
    "simple-git-hooks": "^2.14.0",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,css,md,yaml,yml,astro}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
