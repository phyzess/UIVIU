# Baseline security headers for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  # 180 days, no includeSubDomains, no preload: enough to stop downgrade
  # attacks while staying reversible if HTTPS ever has to move.
  Strict-Transport-Security: max-age=15552000

# Hashed build assets: content never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind index and runtime: rebuilt on every deploy, short cache is enough.
/pagefind/*
  Cache-Control: public, max-age=300, must-revalidate
