---
import EmptyState from "./EmptyState.astro";
import PostListItem from "./PostListItem.astro";
import type { Post } from "../lib/posts";

interface Props {
  posts: Post[];
  heading?: string;
  headingId?: string;
  viewAllHref?: string;
  emptyText?: string;
}

const {
  posts,
  heading = "Latest posts",
  headingId = "latest-posts",
  viewAllHref,
  emptyText = "还没有文章。",
} = Astro.props;
---

<section aria-labelledby={headingId}>
  <div class="flex items-baseline justify-between gap-4 border-b border-rule pb-3">
    <h2
      id={headingId}
      class="font-mono text-[0.75rem] tracking-[0.2em] text-ink-soft uppercase"
    >
      {heading}
    </h2>
    {viewAllHref && (
      <a
        href={viewAllHref}
        class="group font-mono text-[0.75rem] tracking-[0.12em] text-signal-ink no-underline hover:underline hover:underline-offset-4"
      >
        View all
        <span
          aria-hidden="true"
          class="ml-0.5 inline-block transition-transform group-hover:translate-x-0.5"
        >
          →
        </span>
      </a>
    )}
  </div>

  {posts.length === 0 ? (
    <EmptyState
      title={emptyText}
      hint="第一篇还在路上。"
      action={{ href: "/about/", label: "关于这个站点" }}
    />
  ) : (
    <ul>
      {posts.map((post) => (
        <PostListItem post={post} />
      ))}
    </ul>
  )}
</section>
