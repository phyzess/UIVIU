---
import { CORE_CONCEPT_ZH, SITE_NAME } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-rule">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-4 px-6 py-8 md:flex-row md:items-end md:justify-between md:px-10">
    <div class="space-y-1.5">
      <p class="font-display text-base tracking-[0.28em] text-ink">{SITE_NAME}</p>
      <p class="font-mono text-[0.65rem] tracking-[0.2em] text-ink-soft">
        {CORE_CONCEPT_ZH}
      </p>
    </div>
    <div class="flex items-center gap-5">
      <a
        href="/rss.xml"
        class="font-mono text-[0.65rem] tracking-[0.2em] text-ink-soft uppercase underline decoration-rule underline-offset-4 hover:text-ink hover:decoration-signal"
      >
        RSS
      </a>
      <p class="font-mono text-[0.65rem] tracking-[0.2em] text-ink-soft uppercase">
        © {year}
      </p>
    </div>
  </div>
</footer>
