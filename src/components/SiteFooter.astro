---
import { CONTENT_DIRECTIONS_LABEL } from "../lib/site";

const domain = Astro.site?.hostname ?? null;
---

<footer class="mt-16">
  <div class="mx-auto w-full max-w-5xl px-6 md:px-10">
    <div class="border-t border-rule py-9 text-center">
      <p class="font-mono text-[0.65rem] tracking-[0.22em] text-ink-soft uppercase">
        {CONTENT_DIRECTIONS_LABEL}
      </p>
      {domain && (
        <p class="mt-2.5 font-mono text-[0.65rem] tracking-[0.16em] text-ink-soft">
          {domain}
        </p>
      )}
    </div>
  </div>
</footer>
