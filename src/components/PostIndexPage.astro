---
import EmptyState from "./EmptyState.astro";
import PostListItem from "./PostListItem.astro";
import type { Post } from "../lib/posts";

interface Props {
  /** Small uppercase label above the title, e.g. `Notes`. */
  eyebrow: string;
  title: string;
  /** id used by `aria-labelledby` on the section and by the `h1`. */
  headingId: string;
  posts: Post[];
  emptyText: string;
  emptyHint?: string;
}

const { eyebrow, title, headingId, posts, emptyText, emptyHint } = Astro.props;
---

<section class="py-14 md:py-20" aria-labelledby={headingId}>
  <header class="max-w-[42rem]">
    <p class="font-mono text-[0.68rem] tracking-[0.28em] text-ink-soft uppercase">
      {eyebrow}
    </p>
    <h1 id={headingId} class="mt-5 font-display text-3xl leading-tight md:text-4xl">
      {title}
    </h1>
    <p class="mt-4 text-sm leading-relaxed text-ink-soft">
      <slot name="intro" />
    </p>
  </header>

  {posts.length === 0 ? (
    <EmptyState title={emptyText} hint={emptyHint} />
  ) : (
    <ul class="mt-8 max-w-[46rem]">
      {posts.map((post) => (
        <PostListItem post={post} headingLevel={2} />
      ))}
    </ul>
  )}
</section>
