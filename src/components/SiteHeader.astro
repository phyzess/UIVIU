---
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/notes/", label: "Notes" },
  { href: "/archive/", label: "Archive" },
] as const;

const isActive = (href: string) => path === (href.replace(/\/+$/, "") || "/");
---

<header class="pt-7 md:pt-9">
  <div class="mx-auto flex w-full max-w-5xl items-center justify-end gap-6 px-6 sm:gap-8 md:px-10">
    <nav aria-label="主导航">
      <ul class="flex items-center gap-x-5 text-xs sm:gap-x-8 sm:text-sm">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "relative inline-block py-1.5 pb-2 no-underline transition-colors",
                isActive(item.href)
                  ? "text-ink after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-signal"
                  : "text-ink-soft hover:text-ink",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href="/search/"
      aria-label="搜索"
      class="-mr-1 inline-flex size-8 items-center justify-center text-ink-soft no-underline transition-colors hover:text-ink"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.6-3.6"></path>
      </svg>
    </a>
  </div>
</header>
