---
import { CORE_CONCEPT_ZH, SITE_NAME } from "../lib/site";

// Navigation is intentionally limited to routes that exist in this phase.
// Archive, search and about links are added together with their pages.
---

<header class="border-b border-rule">
  <div class="mx-auto flex w-full max-w-5xl items-baseline justify-between px-6 py-6 md:px-10">
    <a
      href="/"
      class="font-display text-xl leading-none tracking-[0.28em] text-ink no-underline"
    >
      {SITE_NAME}
    </a>
    <p class="font-mono text-[0.65rem] tracking-[0.22em] text-ink-soft uppercase">
      {CORE_CONCEPT_ZH}
    </p>
  </div>
</header>
