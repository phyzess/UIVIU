---
import {
  BRAND_HEADLINE_EN,
  BRAND_SUBTITLE_ZH_LINE_1,
  BRAND_SUBTITLE_ZH_LINE_2,
  SITE_NAME,
} from "../lib/site";
---

<section class="pt-14 pb-16 text-center md:pt-24 md:pb-24">
  <h1 class="font-display text-[0.95rem] leading-none tracking-[0.42em] text-ink indent-[0.42em]">
    {SITE_NAME}
  </h1>

  <p class="mx-auto mt-6 max-w-[32rem] font-display text-lg leading-[1.75] text-ink-soft md:max-w-[29.5rem] md:text-xl md:leading-[1.8]">
    {BRAND_HEADLINE_EN}
  </p>

  <p class="mx-auto mt-5 max-w-[27rem] text-[0.95rem] leading-[1.95] text-pretty text-ink/75 md:max-w-[27rem]">
    {BRAND_SUBTITLE_ZH_LINE_1}
    <br class="hidden md:block" />
    {BRAND_SUBTITLE_ZH_LINE_2}
  </p>
</section>
