---
import CategoryTag from "./CategoryTag.astro";
import { postPath, type Post } from "../lib/posts";
import { estimateReadingMinutes } from "../lib/reading-time";
import { formatPostDate } from "../lib/post-utils";

interface Props {
  post: Post;
  /** Archive rows: date and title only, on one line. */
  compact?: boolean;
  /** Heading level for the title; compact rows are not headings. */
  headingLevel?: 2 | 3;
}

const { post, compact = false, headingLevel = 3 } = Astro.props;
const { title, description, pubDate, category } = post.data;
const published = formatPostDate(pubDate);
const minutes = post.body ? estimateReadingMinutes(post.body) : null;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<li class:list={["post-row", compact && "post-row-compact"]}>
  <div class="post-meta">
    <time datetime={published} class="post-date">
      {published}
    </time>
    {!compact && <CategoryTag category={category} />}
    {!compact && minutes !== null && <span class="post-reading">{minutes} min read</span>}
  </div>

  {compact ? (
    <a href={postPath(post)} class="post-title-link post-title-compact">
      {title}
    </a>
  ) : (
    <>
      <Heading class="post-title">
        <a href={postPath(post)} class="post-title-link">
          {title}
        </a>
      </Heading>
      <p class="post-excerpt">{description}</p>
    </>
  )}
</li>

<style>
  .post-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0.45rem;
    padding: 1.6rem 0;
  }

  .post-row + .post-row {
    border-top: 1px solid var(--color-rule);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.85rem;
  }

  .post-date,
  .post-reading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .post-title {
    font-family: var(--font-kai);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .post-title-link {
    color: var(--color-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .post-title-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-signal);
    text-underline-offset: 0.2em;
  }

  .post-excerpt {
    display: -webkit-box;
    overflow: hidden;
    max-width: 34rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-ink-soft);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .post-title-compact {
    font-family: var(--font-kai);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .post-row {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      column-gap: 1rem;
    }

    .post-meta {
      grid-row: 1 / span 2;
      grid-column: 1;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }

    .post-title {
      grid-row: 1;
      grid-column: 2;
      font-size: 1.375rem;
    }

    .post-excerpt {
      grid-row: 2;
      grid-column: 2;
      margin-top: 0.5rem;
    }

    .post-row-compact {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem 1rem;
      padding: 0.5rem 0;
    }

    .post-row-compact .post-meta {
      flex: 0 0 auto;
    }
  }
</style>
