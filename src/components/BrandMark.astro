---
interface Props {
  /** Tailwind size classes; the geometry scales with the box. */
  class?: string;
  /** Accessible name. Leave empty when the mark is decorative. */
  label?: string;
}

const { class: className = "size-6", label } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <!-- Geometry mirrors public/favicon.svg; tests/unit/brand-mark.test.ts guards it. -->
  <path d="M8 8v12q0 4 4 4h8q4 0 4-4V8" stroke="#252525" stroke-width="2.5"></path>
  <path d="M24 8V4" stroke="#FF623D" stroke-width="2.5"></path>
</svg>
