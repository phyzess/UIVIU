---
import type { MarkdownHeading } from "astro";

import CategoryTag from "../components/CategoryTag.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { type Post } from "../lib/posts";
import { estimateReadingMinutes } from "../lib/reading-time";
import { formatPostDate } from "../lib/post-utils";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, category } = post.data;
const published = formatPostDate(pubDate);
const updated = updatedDate ? formatPostDate(updatedDate) : null;
const minutes = post.body ? estimateReadingMinutes(post.body) : null;
---

<BaseLayout title={title} description={description} ogType="article">
  <ReadingProgress />

  <article class="py-14 md:py-20" data-pagefind-body>
    <header class="max-w-[42rem]">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <time
          datetime={published}
          class="font-mono text-[0.75rem] tracking-[0.03em] text-ink-soft"
        >
          {published}
        </time>
        <CategoryTag category={category} />
        {minutes !== null && (
          <span class="font-mono text-[0.75rem] tracking-[0.03em] text-ink-soft">
            {minutes} min read
          </span>
        )}
      </div>

      <h1 class="mt-4 font-kai text-[1.875rem] leading-[1.3] text-balance [overflow-wrap:anywhere] md:text-[2.25rem]">
        {title}
      </h1>

      <p class="mt-4 text-[0.9375rem] leading-[1.85] text-ink-soft">{description}</p>

      {updated && (
        <p class="mt-2 text-[0.8125rem] leading-relaxed text-ink-soft">
          更新于 <span class="font-mono text-[0.75rem]">{updated}</span>
        </p>
      )}
    </header>

    <div class="mt-12 grid gap-12 border-t border-rule pt-10 md:grid-cols-[minmax(0,1fr)_14rem] md:gap-16">
      <div class="post-body min-w-0 max-w-[42rem]" data-post-body>
        <slot />
      </div>
      <aside
        class="min-w-0 md:sticky md:top-10 md:self-start"
        aria-label="文章目录"
        data-pagefind-ignore
      >
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </article>
</BaseLayout>
