---
import newsreaderFont from "@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { BRAND_SUBTITLE_ZH, DEFAULT_DESCRIPTION, SITE_NAME } from "../lib/site";
import "../styles/global.css";

interface Props {
  /** Page title without the site name; the site name is appended automatically. */
  title?: string;
  description?: string;
  /** Open Graph type; posts override this with "article". */
  ogType?: "website" | "article";
  /** Keep the page out of search engines (404 and other non-content pages). */
  noindex?: boolean;
}

const {
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  ogType = "website",
  noindex = false,
} = Astro.props;

const documentTitle = title === SITE_NAME ? SITE_NAME : `${title} — ${SITE_NAME}`;
const canonicalPath = Astro.url.pathname;
const canonicalUrl = Astro.site ? new URL(canonicalPath, Astro.site).href : canonicalPath;
const ogImageUrl = Astro.site ? new URL("/og.png", Astro.site).href : "/og.png";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} RSS`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href={newsreaderFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f8f7f2" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME} — ${BRAND_SUBTITLE_ZH}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="min-h-dvh bg-paper font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-10 focus:border focus:border-rule focus:bg-paper focus:px-3 focus:py-2 focus:font-mono focus:text-xs focus:tracking-[0.18em] focus:uppercase"
    >
      跳到正文
    </a>
    <div class="flex min-h-dvh flex-col">
      <SiteHeader />
      <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-6 md:px-10">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
