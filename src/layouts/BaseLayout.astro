---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { DEFAULT_DESCRIPTION, SITE_NAME } from "../lib/site";
import "../styles/global.css";

interface Props {
  /** Page title without the site name; the site name is appended automatically. */
  title?: string;
  description?: string;
  /** Open Graph type; posts override this with "article". */
  ogType?: "website" | "article";
}

const {
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  ogType = "website",
} = Astro.props;

const documentTitle = title === SITE_NAME ? SITE_NAME : `${title} — ${SITE_NAME}`;
const canonicalPath = Astro.url.pathname;
const canonicalUrl = Astro.site ? new URL(canonicalPath, Astro.site).href : canonicalPath;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} RSS`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-dvh bg-paper font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-10 focus:border focus:border-rule focus:bg-paper focus:px-3 focus:py-2 focus:font-mono focus:text-xs focus:tracking-[0.18em] focus:uppercase"
    >
      跳到正文
    </a>
    <div class="flex min-h-dvh flex-col">
      <SiteHeader />
      <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-6 md:px-10">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
