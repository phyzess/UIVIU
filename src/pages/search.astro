---
import EmptyState from "../components/EmptyState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="搜索" description="在 UIVIU 已发布的文章中搜索标题与正文。">
  <section class="py-14 md:py-20" aria-labelledby="search-title">
    <header class="max-w-[42rem]">
      <p class="font-mono text-[0.68rem] tracking-[0.28em] text-ink-soft uppercase">
        Search
      </p>
      <h1 id="search-title" class="mt-5 font-display text-3xl leading-tight md:text-4xl">
        搜索
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        搜索已发布文章的标题与正文。索引在构建时生成，草稿不会被收录。
      </p>
    </header>

    <form role="search" class="mt-10 max-w-[42rem]" data-search-form>
      <label for="search-input" class="sr-only">
        搜索关键词
      </label>
      <input
        id="search-input"
        name="q"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="输入关键词，例如 Markdown"
        class="w-full border-0 border-b border-rule bg-transparent px-0 py-3 font-display text-2xl leading-snug text-ink placeholder:text-ink-soft focus:border-signal focus:outline-none"
      />
    </form>

    <p
      class="mt-4 min-h-6 max-w-[42rem] font-mono text-[0.7rem] tracking-[0.16em] text-ink-soft uppercase"
      data-search-status
      role="status"
      aria-live="polite"
    ></p>

    <ol class="mt-8 max-w-[42rem]" data-search-results></ol>
    <div class="max-w-[42rem]" data-search-empty hidden></div>

    <template data-search-empty-template>
      <EmptyState
        title="没有找到符合条件的结果。"
        hint="试试换一个关键词，或者浏览全部文章。"
        action={{ href: "/notes/", label: "查看全部文章" }}
      />
    </template>
  </section>
</BaseLayout>

<script>
  import { toSearchResults, type PagefindResultData } from "../lib/search";

  interface PagefindApi {
    search: (query: string) => Promise<{
      results: { data: () => Promise<PagefindResultData> }[];
    }>;
  }

  const input = document.querySelector<HTMLInputElement>("#search-input");
  const list = document.querySelector<HTMLOListElement>("[data-search-results]");
  const status = document.querySelector<HTMLElement>("[data-search-status]");
  const emptyHost = document.querySelector<HTMLElement>("[data-search-empty]");
  const emptyTemplate = document.querySelector<HTMLTemplateElement>(
    "[data-search-empty-template]",
  );

  if (input && list && status && emptyHost && emptyTemplate) {
    const setStatus = (text: string, visuallyHidden = false) => {
      status.textContent = text;
      status.classList.toggle("sr-only", visuallyHidden);
    };

    const showEmpty = (visible: boolean) => {
      emptyHost.hidden = !visible;
      emptyHost.replaceChildren();
      if (visible) {
        emptyHost.append(emptyTemplate.content.cloneNode(true));
      }
      list.hidden = visible;
    };

    const PAGE_SIZE = 8;
    let api: PagefindApi | null = null;
    let unavailable = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let latest = 0;

    const load = async (): Promise<PagefindApi | null> => {
      if (api || unavailable) {
        return api;
      }

      try {
        // Pagefind is generated after `astro build`; the path must stay a runtime
        // import so Vite does not try to resolve a file that does not exist yet.
        const path = "/pagefind/pagefind.js";
        api = (await import(/* @vite-ignore */ path)) as PagefindApi;
        return api;
      } catch {
        unavailable = true;
        status.textContent =
          "搜索索引不可用：先运行 pnpm build，再用 pnpm preview 打开这个页面。";
        return null;
      }
    };

    const render = (items: ReturnType<typeof toSearchResults>) => {
      list.replaceChildren();

      for (const item of items) {
        const row = document.createElement("li");
        row.className = "border-t border-rule";

        const link = document.createElement("a");
        link.href = item.url;
        link.className = "block py-5 no-underline";

        const title = document.createElement("span");
        title.className =
          "block font-display text-xl leading-snug text-ink decoration-signal decoration-1 underline-offset-4 hover:underline";
        title.textContent = item.title;

        const excerpt = document.createElement("span");
        excerpt.className =
          "mt-1 block text-sm leading-relaxed text-ink-soft [&_mark]:bg-signal/25 [&_mark]:text-ink";
        // Pagefind escapes entities in `excerpt` before adding <mark> elements.
        excerpt.innerHTML = item.excerpt;

        link.append(title, excerpt);
        row.append(link);
        list.append(row);
      }
    };

    const run = async (query: string) => {
      const term = query.trim();
      const request = ++latest;

      if (!term) {
        render([]);
        setStatus("");
        showEmpty(false);
        return;
      }

      const pagefind = await load();
      if (!pagefind || request !== latest) {
        return;
      }

      setStatus("搜索中…");

      try {
        const search = await pagefind.search(term);
        if (request !== latest) {
          return;
        }

        const data = await Promise.all(
          search.results.slice(0, PAGE_SIZE).map((result) => result.data()),
        );
        if (request !== latest) {
          return;
        }

        const items = toSearchResults(data);
        render(items);
        showEmpty(items.length === 0);
        setStatus(
          items.length === 0
            ? "没有找到符合条件的结果。"
            : `找到 ${search.results.length} 条结果。`,
          items.length === 0,
        );
      } catch {
        render([]);
        showEmpty(false);
        setStatus("搜索出错了，请重试。");
      }
    };

    const initial = new URLSearchParams(window.location.search).get("q") ?? "";
    if (initial) {
      input.value = initial;
      void run(initial);
    }

    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(() => void run(input.value), 200);
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        clearTimeout(timer);
        input.value = "";
        void run("");
      }
    });
  }
</script>
