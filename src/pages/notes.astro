---
import PostIndexPage from "../components/PostIndexPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();
---

<BaseLayout title="Notes" description="UIVIU 的全部已发布文章，按时间从新到旧。">
  <PostIndexPage
    eyebrow="Notes"
    title="全部文章"
    headingId="notes-title"
    posts={posts}
    emptyText="还没有文章。"
  >
    <Fragment slot="intro">{posts.length} 篇已发布文章，按时间从新到旧。</Fragment>
  </PostIndexPage>
</BaseLayout>
