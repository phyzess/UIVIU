---
import { getEntry, render } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error("Missing src/content/pages/about.md");
}

const { Content } = await render(about);
const { title, description } = about.data;
---

<BaseLayout title={title} description={description}>
  <article class="max-w-[42rem] py-14 md:py-20">
    <header>
      <p class="font-mono text-[0.68rem] tracking-[0.28em] text-ink-soft uppercase">
        About
      </p>
      <h1 class="mt-5 font-display text-3xl leading-tight md:text-4xl">{title}</h1>
    </header>

    <div class="post-body mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>
