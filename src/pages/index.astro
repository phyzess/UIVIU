---
import Hero from "../components/Hero.astro";
import PostList from "../components/PostList.astro";
import Sidebar from "../components/Sidebar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();
const visible = posts.slice(0, 5);
const hasMore = posts.length > visible.length;
---

<BaseLayout preloadBrand>
  <Hero />

  <div class="grid gap-16 pb-4 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-12 xl:gap-16">
    <div>
      <PostList posts={visible} viewAllHref="/notes/" />

      {hasMore && (
        <p class="mt-10 font-mono text-[0.68rem] tracking-[0.06em] text-ink-soft">
          显示 {visible.length} 篇文章，共 {posts.length} 篇
          <a
            href="/notes/"
            class="ml-3 text-ink underline decoration-rule underline-offset-4 hover:decoration-signal"
          >
            更多文章 →
          </a>
        </p>
      )}
    </div>

    <Sidebar posts={posts} />
  </div>
</BaseLayout>
