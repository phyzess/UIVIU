---
import BrandMark from "../components/BrandMark.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404" description="这个页面暂时不存在。" noindex preloadBody={false}>
  <article class="max-w-[42rem] py-16 md:py-24">
    <BrandMark class="mb-6 size-8" />

    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-rule pb-3">
      <p class="font-mono text-[0.75rem] tracking-[0.24em] text-ink-soft uppercase">
        Field note no. <span class="font-pixel text-[0.8rem] tracking-[0.04em]">404</span>
      </p>
      <p class="font-mono text-[0.75rem] tracking-[0.16em] text-ink-soft uppercase">
        Status: unresolved
      </p>
    </div>

    <p class="mt-7 font-mono text-[0.75rem] tracking-[0.2em] text-ink-soft uppercase">
      An unexpected result
    </p>

    <h1 class="mt-3 font-kai text-[1.875rem] leading-[1.3] text-balance md:text-[2.25rem]">
      404. A page of no particular use.
    </h1>

    <p class="mt-5 text-[0.9375rem] leading-[1.9] text-ink-soft">
      经过一番严谨的查找，我们确认：这个页面暂时不存在。
    </p>

    <p class="mt-4 font-display text-base leading-[1.8] text-ink-soft">
      The derivation was sound. The destination was not.
    </p>

    <p class="mt-10">
      <a
        href="/"
        class="group inline-flex items-center gap-1.5 font-sans text-[0.8125rem] tracking-[0.02em] text-ink no-underline underline decoration-rule underline-offset-4 hover:decoration-signal"
      >
        返回首页
        <span
          aria-hidden="true"
          class="inline-block transition-transform group-hover:translate-x-0.5"
        >
          →
        </span>
      </a>
    </p>
  </article>
</BaseLayout>
