---
import EmptyState from "../components/EmptyState.astro";
import PostListItem from "../components/PostListItem.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../lib/posts";
import { groupPostsByYearMonth } from "../lib/post-utils";

const posts = await getPublishedPosts();
const groups = groupPostsByYearMonth(posts);
---

<BaseLayout title="归档" description="UIVIU 全部公开文章，按年月排列。">
  <section class="py-14 md:py-20" aria-labelledby="archive-title">
    <header class="max-w-[42rem]">
      <p class="font-mono text-[0.75rem] tracking-[0.24em] text-ink-soft uppercase">
        Archive
      </p>
      <h1
        id="archive-title"
        class="mt-5 font-kai text-[1.875rem] leading-[1.3] md:text-[2.25rem]"
      >
        归档
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        全部公开文章，按年月排列。草稿不在其中。
      </p>
    </header>

    {groups.length === 0 ? (
      <EmptyState
        title="还没有留下记录。"
        hint="文章发布后会按年月归档在这里。"
        action={{ href: "/notes/", label: "查看全部文章" }}
      />
    ) : (
      <div class="mt-8 space-y-14">
        {groups.map((group) => (
          <section aria-labelledby={`year-${group.year}`}>
            <h2
              id={`year-${group.year}`}
              class="font-kai text-2xl leading-none tracking-[0.06em]"
            >
              {group.year}
            </h2>
            <div class="mt-6 space-y-9">
              {group.months.map((month) => (
                <div>
                  <h3 class="font-sans text-[0.8125rem] tracking-[0.04em] text-ink-soft">
                    {month.month} 月
                  </h3>
                  <ul class="mt-3">
                    {month.posts.map((post) => (
                      <PostListItem post={post} compact />
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
