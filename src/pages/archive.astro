---
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../lib/posts";
import { groupPostsByYearMonth } from "../lib/post-utils";

const posts = await getPublishedPosts();
const groups = groupPostsByYearMonth(posts);
---

<BaseLayout title="归档" description="UIVIU 全部公开文章，按年月排列。">
  <section class="py-14 md:py-20" aria-labelledby="archive-title">
    <header class="max-w-[42rem]">
      <p class="font-mono text-[0.7rem] tracking-[0.28em] text-ink-soft uppercase">
        Archive
      </p>
      <h1 id="archive-title" class="mt-5 font-display text-4xl leading-tight md:text-5xl">
        归档
      </h1>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">
        全部公开文章，按年月排列。草稿不在其中。
      </p>
    </header>

    {groups.length === 0 ? (
      <p class="mt-12 text-base leading-relaxed text-ink-soft">还没有文章。</p>
    ) : (
      <div class="mt-12 space-y-14">
        {groups.map((group) => (
          <section aria-labelledby={`year-${group.year}`}>
            <h2
              id={`year-${group.year}`}
              class="font-display text-2xl leading-none tracking-[0.08em]"
            >
              {group.year}
            </h2>
            <div class="mt-6 space-y-9">
              {group.months.map((month) => (
                <div>
                  <h3 class="font-mono text-[0.7rem] tracking-[0.2em] text-ink-soft uppercase">
                    {month.month} 月
                  </h3>
                  <ul class="mt-3">
                    {month.posts.map((post) => (
                      <PostCard post={post} compact />
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
