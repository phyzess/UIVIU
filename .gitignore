# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# staged writing content: assembled from the private content repository by
# scripts/content.mjs — never committed here
/src/content/

# full font sources used by scripts/fonts.mjs
.fonts-cache/

# generated font subsets (scripts/fonts.mjs); the licence texts stay tracked
/public/fonts/*.woff2
/public/fonts/ui-charset.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local registry or auth overrides (never committed)
.npmrc

# environment variables
.env
.env.*
!.env.example

# test coverage
coverage/

# cloudflare
.wrangler/

# OS and editor misc
.DS_Store
.idea/
