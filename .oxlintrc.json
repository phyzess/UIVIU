{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist/**", ".astro/**", "node_modules/**"]
}
